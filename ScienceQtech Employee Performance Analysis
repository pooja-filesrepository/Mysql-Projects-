-- 16.	Write a query to calculate the bonus for all the employees, based on their ratings and salaries (Use the formula: 5% of salary * employee rating).

SELECT emp_id, first_name, last_name, salary,
rating, (0.05 * salary * rating) AS bonus
FROM emp_records;

-- 17.	Write a query to calculate the average salary distribution based on the continent and country. Take data from the employee record table

SELECT continent, country,
AVG(salary) AS average_salary
FROM employee_record
GROUP BY continent, country
ORDER BY continent, country;

select emp_id, first_name, last_name, salary, country, continent,
 avg(salary) over(partition by country) avg_salary_countrywise,
 avg(salary) over(partition by continent) avg_salary_continentwise,
 count(*) over(partition by country) count_countrywise,
 count(*) over(partition by continent) count_continentwise
 from emp_records;
