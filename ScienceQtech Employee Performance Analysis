-- 1.	Create a database named employee, then import data_science_team.csv proj_table.csv and emp_record_table.csv into the employee database from the given resources.

create database employee;
use employee;
select database();

create table emp_records (
emp_id varchar(50),
first_name varchar(50),
last_name varchar(50),
gender enum ('M','F','O'),
role varchar(100),
dept varchar(100),
exp int,
country varchar(50),
continent varchar(100),
salary int,
emp_rating tinyint,
manager_id varchar(50),
proj_id varchar(50)
);


desc emp_records;

create table proj_table (
project_id varchar(50),
proj_name varchar(250),
domain varchar(50),
start_date date,
closure_date date,
dev_qtr varchar(250),
status varchar(50)
 );

desc proj_table;

update proj_table 
set startdate_new = str_to_date(start_date, '%d-%m-%Y');

update proj_table 
set closuredate_new = str_to_date(closure_date, '%d-%m-%Y');

alter table proj_table
drop column start_date, 
drop column closure_date;


