-- 3.	Write a query to fetch EMP_ID, FIRST_NAME, LAST_NAME, GENDER, and DEPARTMENT from the employee record table, and make a list of employees and details of their department.

select emp_id, first_name, last_name, gender, dept 
 from emp_records;

-- 4.	Write a query to fetch EMP_ID, FIRST_NAME, LAST_NAME, GENDER, DEPARTMENT, and EMP_RATING if the EMP_RATING is: 
•	less than two
•	greater than four 
•	between two and four

select emp_id, first_name, last_name, gender, dept, emp_rating 
 from emp_records where emp_rating <2;

select emp_id, first_name, last_name, gender, dept,emp_rating 
from emp_records
where emp_rating >4;

select emp_id, first_name, last_name, gender, dept,emp_rating 
from emp_records
where emp_rating between 2 and 4;

-- 5.	Write a query to concatenate the FIRST_NAME and the LAST_NAME of employees in the Finance department from the employee table and then give the resultant column alias as NAME.

select concat(first_name,' ',last_name) as full_name 
from emp_records
where dept = 'Finance';


-- 6.	Write a query to list only those employees who have someone reporting to them. Also, show the number of reporters (including the President).

select e.first_name, e.last_name, e.gender, e.dept, e.role from emp_records e
inner join emp_records
on e.emp_id=manager_id
group by e.emp_id
order by e.emp_id;

-- 7.	Write a query to list down all the employees from the healthcare and finance departments using union. Take data from the employee record table.

select emp_id, first_name, last_name, dept, role 
from emp_records where dept = 'Healthcare'
union
select emp_id, first_name, last_name, dept, role
from emp_records where dept = 'Finance'
order by emp_id, dept;

-- 8.	Write a query to list down employee details such as EMP_ID, FIRST_NAME, LAST_NAME, ROLE, DEPARTMENT, and EMP_RATING grouped by dept. Also include the respective employee 
rating along with the max emp rating for the department.

select emp_id, first_name, last_name, role, dept, emp_rating,
max(emp_rating) over(partition by dept) as max_salary 
from emp_records
order by dept;

-- 9.	Write a query to calculate the minimum and the maximum salary of the employees in each role. Take data from the employee record table

select role, min(salary), max(salary) 
from emp_records
group by role;

-- 10.	Write a query to assign ranks to each employee based on their experience. Take data from the employee record table.

select emp_id, first_name, last_name, role, dept, exp,
rank() over (order by exp) as rank_exp
from emp_records;

-- 11.	Write a query to create a view that displays employees in various countries whose salary is more than six thousand. Take data from the employee record table.

create view emp_view as
select emp_id, first_name, last_name, dept, role, country, salary
from emp_records
where salary>6000;

-- 12.	Write a nested query to find employees with experience of more than ten years. Take data from the employee record table.

select emp_id, first_name, last_name, role, dept from emp_records 
where emp_id in(select manager_id from emp_records where exp>10);

-- 13.	Write a query to create a stored procedure to retrieve the details of the employees whose experience is more than three years. Take data from the employee record table.

delimiter &&
create procedure view_emp_records()
begin
select * from emp_records
where exp>3;
end&&

call view_emp_records();

--14.	Write a query using stored functions in the project table to check whether the job profile assigned to each employee in the data science team matches the organization’s set standard.
 The standard being:
For an employee with experience less than or equal to 2 years assign 'JUNIOR DATA SCIENTIST',
For an employee with the experience of 2 to 5 years assign 'ASSOCIATE DATA SCIENTIST',
For an employee with the experience of 5 to 10 years assign 'SENIOR DATA SCIENTIST',
For an employee with the experience of 10 to 12 years assign 'LEAD DATA SCIENTIST',
For an employee with the experience of 12 to 16 years assign 'MANAGER'.

DELIMITER $$
CREATE FUNCTION cust_details(exp INT)
RETURNS VARCHAR(255)
DETERMINISTIC
BEGIN DECLARE cust_detail VARCHAR(255);
    IF exp <= 2 THEN
        SET cust_detail = 'Junior Data Scientist';
    ELSEIF exp > 2 AND exp <= 5 THEN
        SET cust_detail = 'Associate Data Scientist';
    ELSEIF exp > 5 AND exp <= 10 THEN
        SET cust_detail = 'Senior Data Scientist';
    ELSEIF exp > 10 AND exp <= 12 THEN
        SET cust_detail = 'Lead Data Scientist';
    ELSEIF exp > 12 AND exp <= 16 THEN
        SET cust_detail = 'Manager';
    ELSE
        SET cust_detail = 'Executive';
    END IF;
   RETURN cust_detail;
END$$
DELIMITER ;

