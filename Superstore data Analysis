Superstore Dataset Analysis 

-- 1 Create mysql_projects database 

create database if not exists mysql_projects;
use mysql_projects;
select database();

-- 2 Write a query to create a Superstore table.Implement the required check constraint and unique constraint.  

create table if not exists superstore (
Order_id varchar(250) not null,
Order_date varchar(250) not null,
Ship_date varchar(250) not null,
Ship_mode varchar(250) not null,
Customer_id varchar(250) not null,
Customer_name varchar(250) not null,
Segment varchar(250) not null,
Country varchar(250) not null,
City varchar(250) not null,
State varchar(250) not null,
Postal_Code int not null,
Region varchar(250) not null,
Product_id varchar(250) not null,
Category varchar(250) not null,
Sub_category varchar(250) not null,
Product_name varchar(250) not null,
Sales decimal(10,2) not null,
Quantity decimal(10,2) not null,
Discount decimal(10,2) not null,
Profit decimal(10,2) not null,
Shipping_cost decimal(10,2) not null, 
Market varchar(250) not null,
Order_priority varchar(250) not null,
primary key (Order_id));

-- 3. check the dataset 

desc superstore;
select * from superstore;

